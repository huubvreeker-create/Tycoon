; Engine configuration file.
; Project: Kart Empire (mobile, portrait)
;
; To regenerate / inspect, open in the Godot 4 editor.

config_version=5

[application]

config/name="Kart Empire"
config/description="Build your kart racing empire from a small indoor track to a global motorsport business."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://systems/event_bus.gd"
EconomyManager="*res://systems/economy_manager.gd"
GameManager="*res://systems/game_manager.gd"
KartComponents="*res://systems/kart_components.gd"
Facilities="*res://systems/facilities.gd"
Staff="*res://systems/staff.gd"
DailyEvents="*res://systems/daily_events.gd"
SaveManager="*res://systems/save_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/integer_division=0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.06, 0.07, 0.12, 1)
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=1
